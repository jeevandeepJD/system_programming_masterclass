#!/usr/bin/env bash
# Weekly masterclass driver.
#
#   week              -> build + open the latest lesson and challenge
#   week lesson       -> only the lesson PDF
#   week challenge    -> only the challenge material
#   week list         -> list all lessons/challenges so far
#
# Select another module with MC_WEEK=2 week lesson.
#
# Topic modules live in NN-topic-name/
# Consolidated PDFs live at NN-topic-name/week-NN-material.pdf
# Challenges live at NN-topic-name/challenges/

set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MC="$(cd -- "$BIN_DIR/.." && pwd)"
CURSOR="$(find "$HOME/.cursor-server/bin" -path '*/remote-cli/cursor' -print -quit 2>/dev/null || true)"

resolve_module() {
    if [ -n "${MC_WEEK:-}" ]; then
        local matches=("$MC"/"$(printf '%02d' "$((10#$MC_WEEK))")"-*)
        [ -d "${matches[0]}" ] && printf '%s' "${matches[0]}"
        return
    fi

    local latest
    latest="$(ls -d "$MC"/[0-9][0-9]-* 2>/dev/null | sort -V | tail -n1 || true)"
    if [ -z "$latest" ]; then
        return 1
    fi
    printf '%s' "$latest"
}

MODULE="$(resolve_module)"
WEEK_NUMBER="$(basename "$MODULE" | cut -d- -f1)"

open_in_editor() {
    [ -n "$CURSOR" ] && "$CURSOR" "$1" >/dev/null 2>&1 && echo "  opened in editor: $(basename "$1")" \
        || echo "  (cursor CLI unavailable) path: $1"
}

do_lesson() {
    if [ ! -f "$MODULE/overview.md" ]; then
        echo "No weekly module found at $MODULE"
        return 1
    fi
    echo "Module: $(basename "$MODULE")"
    python3 "$MC/tools/build_week.py" "$WEEK_NUMBER" --no-open
    open_in_editor "$MODULE/week-$WEEK_NUMBER-material.pdf"
}

PORT="${MC_PORT:-$((8730 + 10#$WEEK_NUMBER))}"

do_challenge() {
    local challenges=("$MODULE"/challenges/*)
    if [ ! -e "${challenges[0]}" ]; then
        echo "No challenge for $(basename "$MODULE")."
        return 1
    fi

    local challenge html=""
    for challenge in "${challenges[@]}"; do
        [ -f "$challenge" ] || continue
        echo "Challenge: $(basename "$challenge")"
        case "$challenge" in
          *.py)
            echo "  Run: python3 $challenge"
            open_in_editor "$challenge"
            ;;
          *.c)
            echo "  Opened as a coding lab; build instructions are inside."
            open_in_editor "$challenge"
            ;;
          *.html)
            html="$challenge"
            ;;
          *)
            open_in_editor "$challenge"
            ;;
        esac
    done

    if [ -z "$html" ]; then
        return
    fi

    # This box is usually driven remotely (no local DISPLAY), so instead of
    # launching a browser on the VM we serve the page on a local port --
    # Cursor/VS Code remote forwards it to the browser on the user's machine.
    if ! ss -ltn 2>/dev/null | grep -q ":$PORT "; then
        nohup python3 -m http.server "$PORT" --bind 127.0.0.1 \
            --directory "$MODULE/challenges" >/tmp/mc_challenge_server.log 2>&1 &
        sleep 0.4
        echo "  started local server on port $PORT"
    else
        echo "  server already running on port $PORT"
    fi

    echo
    echo "  ==> http://localhost:$PORT/$(basename "$html")"
    echo
    echo "  (if the link does not open, paste the URL into your browser;"
    echo "   the remote session forwards the port)"
    [ -n "$CURSOR" ] && "$CURSOR" "$html" >/dev/null 2>&1 || true
}

case "${1:-all}" in
    lesson)    do_lesson ;;
    challenge) do_challenge ;;
    list)
        echo "== modules ==" ; ls -d "$MC"/[0-9][0-9]-* 2>/dev/null | xargs -r -n1 basename
        echo "== pdfs ==" ; ls -1 "$MC"/[0-9][0-9]-*/week-*-material.pdf 2>/dev/null | xargs -r -n1 basename
        echo "== selected module challenges =="
        for challenge in "$MODULE"/challenges/*; do
            [ -f "$challenge" ] && basename "$challenge"
        done
        true
        ;;
    all)       do_lesson; echo; do_challenge ;;
    *)         sed -n '2,12p' "$0" ;;
esac
