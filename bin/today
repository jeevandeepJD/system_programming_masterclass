#!/usr/bin/env bash
# Daily masterclass driver.
#
#   today              -> build + open the latest lesson and challenge
#   today lesson       -> only the lesson PDF
#   today challenge    -> only the challenge page
#   today list         -> list all lessons/challenges so far
#
# Select another day with MC_DAY=2 today lesson.
#
# Lessons live in   ~/masterclass/daily/lessons/day-NNN-*.md
# PDFs are built to ~/masterclass/daily/pdf/
# Challenges live in ~/masterclass/daily/challenges/day-NNN-*

set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MC="$(cd -- "$BIN_DIR/.." && pwd)"
CURSOR="$(find "$HOME/.cursor-server/bin" -path '*/remote-cli/cursor' -print -quit 2>/dev/null || true)"

resolve_day() {
    if [ -n "${MC_DAY:-}" ]; then
        printf 'day-%03d' "$((10#$MC_DAY))"
        return
    fi

    local latest
    latest="$(ls "$MC"/daily/lessons/day-*.md 2>/dev/null | sort -V | tail -n1 || true)"
    if [ -z "$latest" ]; then
        return 1
    fi
    basename "$latest" | grep -oE '^day-[0-9]+'
}

DAY="$(resolve_day)"

open_in_editor() {
    [ -n "$CURSOR" ] && "$CURSOR" "$1" >/dev/null 2>&1 && echo "  opened in editor: $(basename "$1")" \
        || echo "  (cursor CLI unavailable) path: $1"
}

do_lesson() {
    local md
    md="$(ls "$MC"/daily/lessons/"$DAY"-*.md 2>/dev/null | head -n1 || true)"
    if [ -z "$md" ]; then
        echo "No lesson markdown for $DAY in $MC/daily/lessons/"
        return 1
    fi
    echo "Lesson: $(basename "$md")"
    python3 "$MC/bin/build_lesson.py" "$md" --no-open
    open_in_editor "$MC/daily/pdf/$(basename "${md%.md}").pdf"
}

PORT="${MC_PORT:-8731}"

do_challenge() {
    local challenges=("$MC"/daily/challenges/"$DAY"-*)
    if [ ! -e "${challenges[0]}" ]; then
        echo "No challenge for $DAY."
        return 1
    fi

    local challenge html=""
    for challenge in "${challenges[@]}"; do
        echo "Challenge: $(basename "$challenge")"
        case "$challenge" in
          *.py)
            echo "  Run: python3 $challenge"
            open_in_editor "$challenge"
            ;;
          *.c)
            echo "  Opened as a coding lab; build instructions are inside."
            open_in_editor "$challenge"
            ;;
          *.html)
            html="$challenge"
            ;;
          *)
            open_in_editor "$challenge"
            ;;
        esac
    done

    if [ -z "$html" ]; then
        return
    fi

    # This box is usually driven remotely (no local DISPLAY), so instead of
    # launching a browser on the VM we serve the page on a local port --
    # Cursor/VS Code remote forwards it to the browser on the user's machine.
    if ! ss -ltn 2>/dev/null | grep -q ":$PORT "; then
        nohup python3 -m http.server "$PORT" --bind 127.0.0.1 \
            --directory "$MC/daily/challenges" >/tmp/mc_challenge_server.log 2>&1 &
        sleep 0.4
        echo "  started local server on port $PORT"
    else
        echo "  server already running on port $PORT"
    fi

    echo
    echo "  ==> http://localhost:$PORT/$(basename "$html")"
    echo
    echo "  (if the link does not open, paste the URL into your browser;"
    echo "   the remote session forwards the port)"
    [ -n "$CURSOR" ] && "$CURSOR" "$html" >/dev/null 2>&1 || true
}

case "${1:-all}" in
    lesson)    do_lesson ;;
    challenge) do_challenge ;;
    list)
        echo "== lessons =="   ; ls -1 "$MC"/daily/lessons/day-*    2>/dev/null | xargs -r -n1 basename
        echo "== pdfs =="      ; ls -1 "$MC"/daily/pdf/day-*        2>/dev/null | xargs -r -n1 basename
        echo "== challenges ==" ; ls -1 "$MC"/daily/challenges/day-* 2>/dev/null | xargs -r -n1 basename
        ;;
    all)       do_lesson; echo; do_challenge ;;
    *)         sed -n '2,12p' "$0" ;;
esac
